   14          /*************   功能说明   ***************
   15          
   16          本程序演示多路ADC DMA采样.
   17          
   18          初始化时先把要ADC转换的引脚设置为高阻输入.
   19          
   20          设置数据批量传输(DMA)功能，所有通道一次循环采集的数据自动存放到DMA定义的xdata空间.
   21          
   22          通过串口2(P4.6 P4.7)将DMA定义的xdata空间所收到的数据发送给上位机，波特率115200,N,8,1
   23          
   24          用定时器做波特率发生器，建议使用1T模式(除非低波特率用12T)，并选择可被波特率整除的时钟频率，以提高精度.
   25          
   26          下载时, 选择时钟 22.1184MHz (可以在配置文件"config.h"中修改).
   27          
   28          ******************************************/
   29          
   30          /*************  本地常量声明  **************/
   31          
   32          #define ADC_CH    16      /* 1~16, ADC转换通道数, 需同步修改转换通道 */
   33          #define ADC_DATA  12      /* 6~n, 每个通道ADC转换数据总数, 2*转换次数+4, 需同步修改转换次数 */
   34          
   35          /*************  本地变量声明  **************/
   36          
   37          u8 chn = 0;
   38          u8 xdata DmaAdBuffer[ADC_CH][ADC_DATA];
   39          
   40          /*************  本地函数声明  **************/
   41          
   42          
   43          /*************  外部函数和变量声明 *****************/
   44          
   45          
   46          /******************** IO口配置 ********************/
   47          void  GPIO_config(void)
   48          {
   49   1        P0_MODE_IN_HIZ(GPIO_Pin_LOW | GPIO_Pin_4 | GPIO_Pin_5 | GPIO_Pin_6);    //P0.0~P0.6 设置为高阻输入
   50   1        P1_MODE_IN_HIZ(GPIO_Pin_All);   //P1.0~P1.7 设置为高阻输入
   51   1        P4_MODE_IO_PU(GPIO_Pin_6 | GPIO_Pin_7);   //P4.6,P4.7 设置为准双向口
   52   1      }
   53          
   54          /******************** UART配置 ********************/
   55          void  UART_config(void)
   56          {
   57   1        COMx_InitDefine   COMx_InitStructure;   //结构定义
   58   1      
C251 COMPILER V5.60.0,  main                                                               03/06/25  17:20:10  PAGE 2   

   59   1        COMx_InitStructure.UART_Mode      = UART_8bit_BRTx;   //模式,   UART_ShiftRight,UART_8bit_BRTx,UART_9bit,
             -UART_9bit_BRTx
   60   1      //  COMx_InitStructure.UART_BRT_Use   = BRT_Timer2;     //选择波特率发生器, BRT_Timer2 (注意: 串口2固定使用B
             -RT_Timer2, 所以不用选择)
   61   1        COMx_InitStructure.UART_BaudRate  = 115200ul;     //波特率,     110 ~ 115200
