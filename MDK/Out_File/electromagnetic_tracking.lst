  201          void process_adc_dma_data(void)
  202          {
  203   1          uint8 i, j;
  204   1          uint32 sum_values;
  205   1      
  206   1          // 创建一个临时数组来按 DMA 通道顺序存储平均值
  207   1          float dma_ordered_averages[ADC_DMA_USED_CHANNEL_COUNT];
  208   1          
