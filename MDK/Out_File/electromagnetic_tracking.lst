  215   1          // 清除标志位
  216   1          g_adc_dma_completed_flag = 0;
  217   1          
  218   1          // 1. 从 AdcDmaBuffer 计算平均值，并按 DMA 通道顺序存入 dma_ordered_averages
  219   1          // DMA 物理存储顺序: HC(ch1), HMR(ch3), VR(ch4), HR(ch8), HML(ch9), VL(ch13), HL(ch14)
  220   1          for(i = 0; i < ADC_DMA_USED_CHANNEL_COUNT; i++)
  221   1          {
  222   2              sum_values = 0;
  223   2              for(j = 0; j < ADC_DMA_SAMPLES_PER_CHANNEL_NUM; j++)
  224   2              {
  225   3                  sum_values += AdcDmaBuffer[i][j];
  226   3              }
  227   2              dma_ordered_averages[i] = (float)sum_values / ADC_DMA_SAMPLES_PER_CHANNEL_NUM;
  228   2          }
  229   1      
  230   1          // 2. 根据 sensor_type_e 将数据从 dma_ordered_averages 映射到 result
  231   1          //    result[SENSOR_HL]  <-- 来自 HL (DMA channel 14, AdcDmaBuffer[6])
  232   1          //    result[SENSOR_VL]  <-- 来自 VL (DMA channel 13, AdcDmaBuffer[5])
  233   1          //    result[SENSOR_HML] <-- 来自 HML (DMA channel 9, AdcDmaBuffer[4])
