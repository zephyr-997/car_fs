  172          //========================================================================
  173          // 函数: NVIC_CMP_Init
  174          // 功能: 比较中断初始化.
  175          // 输入: State:    状态, RISING_EDGE/FALLING_EDGE/DISABLE.
  176          //       Priority: 优先级, Priority_0,Priority_1,Priority_2,Priority_3.
  177          // 输出: 返回值 SUCCESS/FAIL.
  178          // 版本: V1.0, 2020-09-29
  179          //========================================================================
  180          u8 NVIC_CMP_Init(u8 State, u8 Priority)
  181          {
  182   1        if(State & RISING_EDGE) PIE = 1;      //允许上升沿触发
  183   1        else  PIE = 0;      //禁止下降沿触发
  184   1        if(State & FALLING_EDGE)  NIE = 1;    //允许下降沿触发
  185   1        else  NIE = 0;      //禁止下降沿触发
  186   1        if(Priority <= Priority_3) CMP_Priority(Priority); else  return FAIL;
  187   1        return SUCCESS;
  188   1      }
  189          
