  191          // 函数: NVIC_I2C_Init
  192          // 功能: I2C中断初始化.
  193          // 输入: Mode:     模式, I2C_Mode_Master/I2C_Mode_Slave.
  194          //       State:    状态, I2C_Mode_Master: ENABLE/DISABLE.
  195          //                              I2C_Mode_Slave: I2C_ESTAI/I2C_ERXI/I2C_ETXI/I2C_ESTOI/DISABLE.
  196          //       Priority: 优先级, Priority_0,Priority_1,Priority_2,Priority_3.
  197          // 输出: 返回值 SUCCESS/FAIL.
  198          // 版本: V1.0, 2020-09-29
  199          //========================================================================
  200          u8 NVIC_I2C_Init(u8 Mode, u8 State, u8 Priority)
  201          {
  202   1        if(Mode > 1) return FAIL;
  203   1        if(Mode == 1) //I2C_Mode_Master
  204   1        {
  205   2          I2C_Master_Inturrupt(State);
  206   2        }
  207   1        else if(Mode == 0)  //I2C_Mode_Slave
  208   1        {
  209   2          I2CSLCR = (I2CSLCR & ~0x78) | State;
  210   2        }
  211   1        if(Priority <= Priority_3) CMP_Priority(Priority); else  return FAIL;
  212   1        return SUCCESS;
  213   1      }
