  344          //========================================================================
  345          // 函数: NVIC_DMA_ADC_Init
  346          // 功能: DMA ADC中断初始化.
  347          // 输入: State:    状态, ENABLE/DISABLE.
  348          //       Priority: 优先级, Priority_0,Priority_1,Priority_2,Priority_3.
  349          //       Bus_Priority: 总线优先级, Priority_0,Priority_1,Priority_2,Priority_3.
  350          // 输出: 返回值 SUCCESS/FAIL.
  351          // 版本: V1.0, 2021-05-21
  352          //========================================================================
  353          u8 NVIC_DMA_ADC_Init(u8 State, u8 Priority, u8 Bus_Priority)
  354          {
  355   1        DMA_ADC_CFG &= ~0x0f;
  356   1        if(Priority <= Priority_3) DMA_ADC_CFG |= Priority << 2;
  357   1        if(Bus_Priority <= Priority_3) DMA_ADC_CFG |= Bus_Priority; //总线优先级
  358   1        if(State == ENABLE)
  359   1          DMA_ADC_CFG |= 0x80;    //bit7 1:Enable Interrupt
  360   1        else
  361   1          DMA_ADC_CFG &= ~0x80;   //bit7 0:Disable Interrupt
  362   1        return SUCCESS;
  363   1      }
