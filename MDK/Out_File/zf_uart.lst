  234          //-------------------------------------------------------------------------------------------------------
             -------------
  235          void uart_putbuff(UARTN_enum uart_n,uint8 *p,uint32 len)
  236          {
  237   1          while(len--)
  238   1              uart_putchar(uart_n,*p++);
  239   1      }
