  195          //  @brief      串口发送字符串
  196          //  @param      uart_n          串口模块号(USART_1,USART_2,USART_3,USART_4)
  197          //  @param      *str            要发送的字符串地址
  198          //  @return     void
  199          //  Sample usage:               uart_putstr(UART_1,"i lvoe you"); 
  200          //-------------------------------------------------------------------------------------------------------
             -------------
  201          void uart_putchar(UARTN_enum uart_n,uint8 dat)
  202          {
  203   1        switch(uart_n)
  204   1        {
  205   2          case UART_1:
  206   2            while (busy[1]);
  207   2            busy[1] = 1;
  208   2            SBUF = dat;
  209   2              break;
  210   2          case UART_2:
  211   2            while (busy[2]);
  212   2            busy[2] = 1;
  213   2            S2BUF = dat;
  214   2              break;
  215   2          case UART_3:
  216   2            while (busy[3]);
  217   2            busy[3] = 1;
  218   2            S3BUF = dat;
  219   2              break;
  220   2          case UART_4:
  221   2            while (busy[4]);
  222   2            busy[4] = 1;
  223   2            S4BUF = dat;
  224   2              break;
  225   2        }
  226   1      }
