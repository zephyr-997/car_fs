             -------------
  204          void uart_putchar(UARTN_enum uart_n,uint8 dat)
  205          {
  206   1        switch(uart_n)
  207   1        {
  208   2          case UART_1:
  209   2            while (busy[1]);
  210   2            busy[1] = 1;
  211   2            SBUF = dat;
  212   2              break;
  213   2          case UART_2:
  214   2            while (busy[2]);
  215   2            busy[2] = 1;
  216   2            S2BUF = dat;
  217   2              break;
  218   2          case UART_3:
  219   2            while (busy[3]);
  220   2            busy[3] = 1;
  221   2            S3BUF = dat;
  222   2              break;
  223   2          case UART_4:
  224   2            while (busy[4]);
  225   2            busy[4] = 1;
  226   2            S4BUF = dat;
  227   2              break;
  228   2        }
  229   1      }
