   10          //========================================================================
   11          // 函数: DMA_ADC_ISR_Handler
   12          // 描述: DMA ADC 中断函数.
   13          // 参数: none.
   14          // 返回: none.
   15          // 版本: V1.0, 2022-03-23
   16          //========================================================================
   17          void DMA_ADC_ISR_Handler (void) interrupt DMA_ADC_VECTOR
   18          {
   19   1        // 检查 DMA ADC 传输完成中断标志 (DMA_IF, bit 7 of DMA_ADC_STA)
   20   1        if(DMA_ADC_STA & 0x80)  
   21   1        {
   22   2          DMA_ADC_STA &= ~0x80;   // 清除 DMA ADC 传输完成中断标志 (DMA_IF, bit 7)
   23   2          g_adc_dma_completed_flag = 1; // 设置项目全局标志
   24   2        }
   25   1        
   26   1        // 处理非法触发错误标志 (TRIG_ERR_IF, bit 0)
   27   1        if(DMA_ADC_STA & 0x01)
   28   1        {
   29   2          DMA_ADC_STA &= ~0x01; // 清除非法触发错误标志
   30   2          // 可以在此处添加错误处理代码
   31   2        }
   32   1      }
   33          
