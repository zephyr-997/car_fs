    7          //========================================================================
    8          // 函数: u8 ADC_Inilize(ADC_InitTypeDef *ADCx)
    9          // 描述: ADC初始化程序.
   10          // 参数: ADCx: 结构参数,请参考adc.h里的定义.
   11          // 返回: none.
   12          // 版本: V1.0, 2012-10-22
   13          //========================================================================
   14          u8  ADC_Inilize(ADC_InitTypeDef *ADCx)
   15          {
   16   1        ADCCFG = (ADCCFG & ~ADC_SPEED_2X16T) | ADCx->ADC_Speed; //设置ADC工作时钟频率
   17   1        ADC_Justify(ADCx->ADC_AdjResult);   //AD转换结果对齐方式
   18   1      
   19   1        if(ADCx->ADC_SMPduty > 31)  return FAIL;  //错误
   20   1        if(ADCx->ADC_CsSetup > 1) return FAIL;  //错误
   21   1        if(ADCx->ADC_CsHold > 3)  return FAIL;  //错误
   22   1      
   23   1        ADCTIM = (ADCx->ADC_CsSetup << 7) | (ADCx->ADC_CsHold << 5) | ADCx->ADC_SMPduty ;   //设置 ADC 内部时序，
             -ADC采样时间建议设最大值
   24   1        return SUCCESS;
   25   1      }
   26          
   27          
   28          //========================================================================
   29          // 函数: void ADC_PowerControl(u8 pwr)
   30          // 描述: ADC电源控制程序.
   31          // 参数: pwr: 电源控制,ENABLE或DISABLE.
   32          // 返回: none.
   33          // 版本: V1.0, 2012-10-22
   34          //========================================================================
   35          void  ADC_PowerControl(u8 pwr)
   36          {
   37   1        if(pwr == ENABLE) ADC_POWER = 1;
   38   1        else        ADC_POWER = 0;
   39   1      }
   40          
   41          //========================================================================
   42          // 函数: u16  Get_ADCResult(u8 channel)
   43          // 描述: 查询法读一次ADC转换结果.
   44          // 参数: channel: 选择要转换的ADC通道.
   45          // 返回: ADC转换结果.
   46          // 版本: V1.0, 2012-10-22
   47          //========================================================================
   48          u16 Get_ADCResult(u8 channel) //channel = 0~15
   49          {
   50   1        u16 adc;
   51   1        u8  i;
   52   1      
   53   1        if(channel > ADC_CH15)  return  4096; //错误,返回4096,调用的程序判断  
   54   1        ADC_RES = 0;
   55   1        ADC_RESL = 0;
   56   1      
C251 COMPILER V5.60.0,  STC32G_ADC                                                         04/06/25  14:41:49  PAGE 2   

   57   1        ADC_CONTR = (ADC_CONTR & 0xf0) | channel; //设置ADC转换通道
   58   1        ADC_START = 1;//启动ADC转换
   59   1        NOP(10);      //对ADC_CONTR操作后要4T之后才能访问
   60   1      
   61   1        for(i=0; i<250; i++)    //超时返回，正常i等于10以内就可以转换完成
   62   1        {
   63   2          if(ADC_FLAG)
   64   2          {
   65   3            ADC_FLAG = 0; //清除ADC转换结束标志
   66   3            if(RESFMT)    //转换结果右对齐。 
   67   3            {
   68   4              adc = ((u16)ADC_RES << 8) | ADC_RESL;
   69   4            }
   70   3            else    //转换结果左对齐。 
   71   3            {
   72   4              adc = (u16)ADC_RES;
   73   4              adc = (adc << 4) | ((ADC_RESL >> 4) & 0x0f);
   74   4            }
   75   3            return  adc;
   76   3          }
   77   2        }
   78   1        return  4096; //错误,返回4096,调用的程序判断
   79   1      }


